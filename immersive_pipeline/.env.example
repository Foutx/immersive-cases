# LLM: gigachat | ollama | openai (совместимый API) | none
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_STRUCTURED=0
# SSL_CERT_FILE=C:/path/to/trusted-ca-bundle.pem
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Поиск видео. Без ключей работает только duckduckgo (медленнее и хуже).
YOUTUBE_API_KEY=
VIMEO_TOKEN=
SEARCH_BACKENDS=youtube,vimeo,duckduckgo

# Уже собранные кейсы, с которыми нельзя дублироваться (через ":" в Linux/macOS, ";" в Windows)
# Windows, запуск из корня репозитория:
# EXISTING_CASES=immersive_pipeline/data/existing_cases.json;cases.json
