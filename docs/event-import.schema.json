{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "environment",
            "visitor_actions",
            "system_response",
            "visitor_role",
            "immersion_mechanism",
            "dates",
            "location",
            "occurred"
          ],
          "title": "Field",
          "type": "string"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "field",
        "value",
        "evidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EventImport": {
      "additionalProperties": false,
      "properties": {
        "source_record_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 2,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_url": {
          "format": "uri",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "start_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Date"
        },
        "end_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "reported_year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Year"
        },
        "country_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "city": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "venue": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "location_text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Text"
        },
        "organizers": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Organizers",
          "type": "array"
        },
        "studios": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Studios",
          "type": "array"
        },
        "client_name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Name"
        },
        "format_text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format Text"
        },
        "category": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "title": "Tags",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "proofs": {
          "items": {
            "$ref": "#/$defs/Proof"
          },
          "minItems": 1,
          "title": "Proofs",
          "type": "array"
        },
        "occurrence": {
          "default": "unknown",
          "enum": [
            "unknown",
            "announced",
            "ongoing",
            "completed"
          ],
          "title": "Occurrence",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_method": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Method"
        }
      },
      "required": [
        "source_record_id",
        "title",
        "description",
        "source_url",
        "proofs"
      ],
      "title": "EventImport",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "url",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Proof": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official",
            "article",
            "video",
            "photo",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked At"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "relevance": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "automatic_match"
          ],
          "title": "Relevance",
          "type": "string"
        }
      },
      "required": [
        "url",
        "kind"
      ],
      "title": "Proof",
      "type": "object"
    },
    "Tag": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "format",
            "technology"
          ],
          "title": "Kind",
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Slug",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "slug"
      ],
      "title": "Tag",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "producer": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Producer",
      "type": "string"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventImport"
      },
      "maxItems": 1000,
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "producer",
    "collected_at",
    "events"
  ],
  "title": "ImportBatch",
  "type": "object"
}